# Configure Rust toolchain to match Makefile.rust.defs
# This ensures `cargo` commands use the same toolchain as `make`
export CARGO_HOME="$PWD/rust/cargo"
PATH_add "$CARGO_HOME/bin"

# Ensure Rust toolchain is installed
if [[ ! -x "$CARGO_HOME/bin/cargo" ]]; then
    log_status "Rust toolchain not found, running 'make rust-fetch'..."
    make rust-fetch
fi
